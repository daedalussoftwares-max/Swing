{
  "name": "swing",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "react-native start --host 0.0.0.0",
    "lan:sync": "node scripts/sync-lan-env.mjs",
    "metro:restart": "bash scripts/metro-restart.sh",
    "ios": "react-native run-ios",
    "ios:sim": "react-native run-ios --simulator \"iPhone 17 Pro\"",
    "android": "react-native run-android",
    "postinstall": "node scripts/patch-gradle-plugin.mjs && node scripts/patch-nitro-hybrid.mjs && node scripts/patch-react-native-assert.mjs",
    "android:apk": "bash scripts/android-apk.sh",
    "android:device": "bash scripts/android-device.sh run",
    "android:device:apk": "bash scripts/android-device.sh apk",
    "android:device:check": "bash scripts/android-device.sh check",
    "lan-ip": "node -e \"const {execSync}=require('child_process');const i=(k)=>{try{return execSync('ipconfig getifaddr '+k,{encoding:'utf8'}).trim()}catch{return ''}}; console.log(i('en0')||i('en1')||'Set SWING_API_URL manually');\"",
    "android:studio": "open -a \"Android Studio\" android",
    "ios:xcode": "open ios/swing.xcworkspace",
    "lint": "eslint ."
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-firebase/app": "26.4.0",
    "@react-native-firebase/messaging": "26.4.0",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-image-picker": "^8.2.0",
    "react-native-keychain": "^10.0.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-nitro-sound": "0.2.20",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.14.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.5",
    "@react-native/gradle-plugin": "0.81.5",
    "@react-native/metro-config": "0.81.5",
    "@types/react": "~19.1.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-inline-dotenv": "^1.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0"
  },
  "private": true
}
