<?xml version="1.0" encoding="utf-8"?>
<!--
  Local dev: API is http://YOUR_LAN_IP:8080. Tighten (cleartext false + HTTPS) before store release.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
