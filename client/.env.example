# Copy to client/.env — loaded at Metro build time via react-native-dotenv.
# Find laptop IP: hostname -I | awk '{print $1}'

# Physical phone (same Wi‑Fi / hotspot as laptop)
SWING_API_URL=http://172.20.10.2:8080

# Google OAuth — see client/GOOGLE-AUTH-SETUP.md
SWING_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
SWING_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
SWING_GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Android emulator only
# SWING_API_URL=http://10.0.2.2:8080

# Legacy EXPO_PUBLIC_* names still work if you already have them in .env
